# Apache (Plesk avec Apache / PHP) : SPA React — évite le 404 au rechargement
# Déployer le contenu de dist/ à la racine du site (ex. httpdocs), avec ce fichier.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
